    {
      "@id":          "ica:instance/RES-2847",
      "@type":        "ica:Resolution",
      "ica:nodeType": "Resolution",
      "ica:resolution_id":   "RES-2847",
      "ica:incident_id":     "INC-2847",
      "ica:root_cause":      "Nightly batch job archive_orders_v2.sh executed a full-table-scan query against a 400M-row orders table with no query timeout configured.",
      "ica:resolution_steps":["Identified runaway process via SHOW PROCESSLIST","Terminated long-running query with KILL <pid>","Added SET SESSION max_statement_time=300 to batch script","Rescheduled cron from 01:30 UTC to 04:00 UTC"],
      "ica:action_items":    ["PLAT-4401: Add timeout to all batch scripts","DB-892: Index on orders.archived_at","PLAT-4402: Reschedule archival cron","OBS-210: Alert for queries > 10 min"],
      "ica:lessons_learned": "All DB batch jobs must declare a query timeout before reaching production.",
      "ica:resolved_by":     "Sarah Mitchell",
      "ica:resolved_at":     "2025-06-10T02:49:00Z",
      "ica:duration_minutes":35,
      "ica:prevention_measures":["CI lint rule for batch scripts without timeout","PagerDuty alert for queries running > 10 minutes"],
      "RESOLVES": { "@id": "ica:instance/INC-2847" }
    },

    {
      "@id":          "ica:instance/RES-3012",
      "@type":        "ica:Resolution",
      "ica:nodeType": "Resolution",
      "ica:resolution_id":   "RES-3012",
      "ica:incident_id":     "INC-3012",
      "ica:root_cause":      "New feature deployment introduced a DB query on orders table without a composite index, causing full table scans under load.",
      "ica:resolution_steps":["Identified full table scan in slow query log","Added composite index on orders(user_id, created_at)","Deployed hotfix to production","Confirmed CPU normalised on monitoring"],
      "ica:action_items":    ["DB-901: Enforce EXPLAIN check in PR review","CICD-290: Add DB migration validator to pipeline"],
      "ica:lessons_learned": "All DB migrations must be validated with EXPLAIN ANALYZE before deployment.",
      "ica:resolved_by":     "James Okafor",
      "ica:resolved_at":     "2025-04-22T14:57:00Z",
      "ica:duration_minutes":52,
      "ica:prevention_measures":["Required EXPLAIN ANALYZE in PR template","Slow query threshold alert added"],
      "RESOLVES": { "@id": "ica:instance/INC-3012" }
    },

    {
      "@id":          "ica:instance/RES-3301",
      "@type":        "ica:Resolution",
      "ica:nodeType": "Resolution",
      "ica:resolution_id":   "RES-3301",
      "ica:incident_id":     "INC-3301",
      "ica:root_cause":      "Connection leak introduced in exception handler — connection.close() missing in catch block, exhausting HikariCP pool.",
      "ica:resolution_steps":["Identified pool exhaustion from HikariCP metrics","Rolled back deployment to previous version","Fixed connection.close() in catch block","Redeployed with fix"],
      "ica:action_items":    ["PLAT-4410: Add connection leak detection to code review checklist","OBS-215: Alert on HikariCP pool > 80%"],
      "ica:lessons_learned": "All DB connection handling must use try-with-resources to guarantee close.",
      "ica:resolved_by":     "Priya Nair",
      "ica:resolved_at":     "2025-05-14T10:01:00Z",
      "ica:duration_minutes":28,
      "ica:prevention_measures":["Static analysis rule for unclosed connections","HikariCP leak detection enabled in staging"],
      "RESOLVES": { "@id": "ica:instance/INC-3301" }
    },

    {
      "@id":          "ica:instance/RES-3455",
      "@type":        "ica:Resolution",
      "ica:nodeType": "Resolution",
      "ica:resolution_id":   "RES-3455",
      "ica:incident_id":     "INC-3455",
      "ica:root_cause":      "OS upgrade silently removed logrotate drop-in config for application logs, causing 7 days of unrotated logs to accumulate.",
      "ica:resolution_steps":["Identified large log files with du -sh /var/log/*","Manually rotated logs with logrotate -f","Freed 47 GB disk space","Restored logrotate config from source control","Verified service recovery"],
      "ica:action_items":    ["INFRA-5901: Add logrotate config to OS upgrade checklist","OBS-220: Alert if logrotate has not run in 24 hours"],
      "ica:lessons_learned": "OS upgrade procedures must include a post-upgrade logrotate validation step.",
      "ica:resolved_by":     "Carlos Rivera",
      "ica:resolved_at":     "2025-06-01T11:30:00Z",
      "ica:duration_minutes":20,
      "ica:prevention_measures":["Post-upgrade checklist includes logrotate verification","Daily logrotate success alert added"],
      "RESOLVES": { "@id": "ica:instance/INC-3455" }
    },

    {
      "@id":          "ica:instance/RES-3601",
      "@type":        "ica:Resolution",
      "ica:nodeType": "Resolution",
      "ica:resolution_id":   "RES-3601",
      "ica:incident_id":     "INC-3601",
      "ica:root_cause":      "Misconfigured PAYMENT_GATEWAY_URL in Helm values.yaml pointed to staging gateway instead of production, inherited during chart refactor.",
      "ica:resolution_steps":["Identified crash from pod logs: invalid PAYMENT_GATEWAY_URL","Confirmed staging URL in values.yaml diff","Ran kubectl rollout undo deployment/payment-service","Verified recovery on pod logs and Stripe dashboard","Deployed v4.2.1 hotfix with corrected config"],
      "ica:action_items":    ["INFRA-6101: Separate env-specific values into values-<env>.yaml","CICD-330: CI validation for required prod env vars","PAY-1142: Startup probe for payment gateway connectivity","CICD-331: Auto-diff check for staging URLs in prod manifests"],
      "ica:lessons_learned": "Production Helm values must never inherit from a shared base that includes environment-specific URLs.",
      "ica:resolved_by":     "Yuki Tanaka",
      "ica:resolved_at":     "2025-07-22T16:15:00Z",
      "ica:duration_minutes":12,
      "ica:prevention_measures":["CI step validates all production env vars","Automated diff check for staging URLs in production manifests"],
      "RESOLVES": { "@id": "ica:instance/INC-3601" }
    },

