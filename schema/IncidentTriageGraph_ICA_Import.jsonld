    {
      "@comment": "======================================================",
      "@comment": "NODE TYPE: EscalationPath (4 instances)",
      "@comment": "======================================================"
    },

    {
      "@id":          "ica:instance/escalation/P1-path",
      "@type":        "ica:EscalationPath",
      "ica:nodeType": "EscalationPath",
      "ica:path_id":               "P1-path",
      "ica:severity":              "P1",
      "ica:initial_response_sla":  "5 minutes",
      "ica:resolution_target":     "2 hours",
      "ica:pagerduty_service":     "infra-oncall",
      "ica:slack_channel":         "#incidents-p1",
      "ica:bridge_call_required":  true,
      "ica:steps": [
        { "ica:at_minutes": 0,   "ica:action": "Primary on-call acknowledges PagerDuty alert",          "ica:owner": "Primary On-Call"    },
        { "ica:at_minutes": 5,   "ica:action": "Secondary on-call paged if unacknowledged",             "ica:owner": "PagerDuty (auto)"   },
        { "ica:at_minutes": 10,  "ica:action": "Open bridge call; post in #incidents-p1",               "ica:owner": "Primary On-Call"    },
        { "ica:at_minutes": 15,  "ica:action": "Notify Escalation Manager via direct page",             "ica:owner": "Primary On-Call"    },
        { "ica:at_minutes": 30,  "ica:action": "Escalation Manager engages VP Engineering",             "ica:owner": "Escalation Manager" },
        { "ica:at_minutes": 60,  "ica:action": "Executive stakeholder notification if no ETA",          "ica:owner": "VP Engineering"     },
        { "ica:at_minutes": 120, "ica:action": "Incident review initiated if still unresolved",         "ica:owner": "Escalation Manager" }
      ]
    },

    {
      "@id":          "ica:instance/escalation/P2-path",
      "@type":        "ica:EscalationPath",
      "ica:nodeType": "EscalationPath",
      "ica:path_id":               "P2-path",
      "ica:severity":              "P2",
      "ica:initial_response_sla":  "15 minutes",
      "ica:resolution_target":     "4 hours",
      "ica:pagerduty_service":     "infra-oncall",
      "ica:slack_channel":         "#incidents-p2",
      "ica:bridge_call_required":  false,
      "ica:steps": [
        { "ica:at_minutes": 0,   "ica:action": "Primary on-call acknowledges PagerDuty alert",          "ica:owner": "Primary On-Call"    },
        { "ica:at_minutes": 15,  "ica:action": "Secondary on-call paged if unacknowledged",             "ica:owner": "PagerDuty (auto)"   },
        { "ica:at_minutes": 30,  "ica:action": "Post status update in #incidents-p2",                   "ica:owner": "Primary On-Call"    },
        { "ica:at_minutes": 60,  "ica:action": "Notify Escalation Manager if no resolution path found", "ica:owner": "Primary On-Call"    },
        { "ica:at_minutes": 120, "ica:action": "Auto-promote to P1 if unresolved",                      "ica:owner": "Escalation Manager" }
      ]
    },

    {
      "@id":          "ica:instance/escalation/P3-path",
      "@type":        "ica:EscalationPath",
      "ica:nodeType": "EscalationPath",
      "ica:path_id":               "P3-path",
      "ica:severity":              "P3",
      "ica:initial_response_sla":  "1 hour (business hours)",
      "ica:resolution_target":     "24 hours",
      "ica:pagerduty_service":     "infra-oncall",
      "ica:slack_channel":         "#infra-oncall",
      "ica:bridge_call_required":  false,
      "ica:steps": [
        { "ica:at_minutes": 60, "ica:action": "Acknowledge during business hours; post in #infra-oncall", "ica:owner": "Primary On-Call" }
      ]
    },

    {
      "@id":          "ica:instance/escalation/P4-path",
      "@type":        "ica:EscalationPath",
      "ica:nodeType": "EscalationPath",
      "ica:path_id":               "P4-path",
      "ica:severity":              "P4",
      "ica:initial_response_sla":  "1 business day",
      "ica:resolution_target":     "Next sprint",
      "ica:pagerduty_service":     "infra-oncall",
      "ica:slack_channel":         "#infra-oncall",
      "ica:bridge_call_required":  false,
      "ica:steps": [
        { "ica:at_minutes": 480, "ica:action": "Jira ticket created and triaged next business day", "ica:owner": "On-Call Engineer" }
      ]
    }

  ]
}
