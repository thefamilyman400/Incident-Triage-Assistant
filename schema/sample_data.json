  {
    "nodeType": "Resolution",
    "resolution_id": "RES-2847",
    "incident_id": "INC-2847",
    "root_cause": "Nightly batch job archive_orders_v2.sh executed a full-table-scan query against 400M-row orders table with no query timeout configured.",
    "resolution_steps": [
      "Identified runaway process via SHOW PROCESSLIST",
      "Terminated long-running query with KILL <pid>",
      "Added SET SESSION max_statement_time=300 to batch script",
      "Rescheduled cron from 01:30 UTC to 04:00 UTC"
    ],
    "action_items": ["PLAT-4401", "DB-892", "PLAT-4402", "OBS-210"],
    "lessons_learned": "All DB batch jobs must declare a query timeout before reaching production.",
    "resolved_by": "Sarah Mitchell",
    "resolved_at": "2025-06-10T02:49:00Z",
    "duration_minutes": 35,
    "prevention_measures": [
      "CI lint rule for batch scripts without timeout",
      "PagerDuty alert for queries running > 10 minutes"
    ]
  },
  {
    "nodeType": "Resolution",
    "resolution_id": "RES-3012",
    "incident_id": "INC-3012",
    "root_cause": "New feature deployment introduced a DB query on orders table without a composite index, causing full table scans under load.",
    "resolution_steps": [
      "Identified full table scan in slow query log",
      "Added composite index on orders(user_id, created_at)",
      "Deployed hotfix to production",
      "Confirmed CPU normalised on monitoring"
    ],
    "action_items": ["DB-901", "CICD-290"],
    "lessons_learned": "All DB migrations must be validated with EXPLAIN ANALYZE before deployment.",
    "resolved_by": "James Okafor",
    "resolved_at": "2025-04-22T14:57:00Z",
    "duration_minutes": 52,
    "prevention_measures": [
      "Required EXPLAIN ANALYZE in PR template",
      "Slow query threshold alert added"
    ]
  },
  {
    "nodeType": "Resolution",
    "resolution_id": "RES-3301",
    "incident_id": "INC-3301",
    "root_cause": "Connection leak introduced in exception handler — connection.close() missing in catch block, exhausting HikariCP pool.",
    "resolution_steps": [
      "Identified pool exhaustion from HikariCP metrics",
      "Rolled back deployment to previous version",
      "Fixed connection.close() in catch block",
      "Redeployed with fix"
    ],
    "action_items": ["PLAT-4410", "OBS-215"],
    "lessons_learned": "All DB connection handling must use try-with-resources to guarantee close.",
    "resolved_by": "Priya Nair",
    "resolved_at": "2025-05-14T10:01:00Z",
    "duration_minutes": 28,
    "prevention_measures": [
      "Static analysis rule for unclosed connections",
      "HikariCP leak detection enabled in staging"
    ]
  },
  {
    "nodeType": "Resolution",
    "resolution_id": "RES-3455",
    "incident_id": "INC-3455",
    "root_cause": "OS upgrade silently removed logrotate drop-in config for application logs, causing 7 days of unrotated logs to accumulate.",
    "resolution_steps": [
      "Identified large log files with du -sh /var/log/*",
      "Manually rotated logs with logrotate -f",
      "Freed 47 GB disk space",
      "Restored logrotate config from source control",
      "Verified service recovery"
    ],
    "action_items": ["INFRA-5901", "OBS-220"],
    "lessons_learned": "OS upgrade procedures must include a post-upgrade logrotate validation step.",
    "resolved_by": "Carlos Rivera",
    "resolved_at": "2025-06-01T11:30:00Z",
    "duration_minutes": 20,
    "prevention_measures": [
      "Post-upgrade checklist includes logrotate verification",
      "Daily logrotate success alert added"
    ]
  },
  {
