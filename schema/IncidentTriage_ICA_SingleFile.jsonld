      "ica:source_file": "INC-2847-HIGH-CPU-BATCH-JOB.md",
      "ica:on_call_engineer": "Sarah Mitchell",
      "ica:duration_minutes": 35,
      "ica:created_at": "2025-06-10T02:14:00Z",
      "ica:resolved_at": "2025-06-10T02:49:00Z",
      "ica:tags": "cpu,batch-job,database,postgres",
      "embeddingField": "Incident INC-2847. Production DB CPU Spike caused by runaway batch job. Severity P2. Affected services: prod-db-01, Order Management API, Reporting Service. Root cause: archive_orders_v2.sh ran full-table-scan with no query timeout. Resolution: killed query, added timeout, rescheduled cron.",
      "TRIGGERED_BY":  "ica:alert-HighCPUUsage",
      "RESOLVED_BY":   "ica:RES-2847",
      "GUIDED_BY":     "ica:runbook-HIGH_CPU_RUNBOOK",
      "ESCALATES_TO":  "ica:P2-path",
      "AFFECTS":       "ica:system-prod-db-01",
      "SIMILAR_TO":    "ica:INC-3012"
    },

    {
      "@id": "ica:INC-3012",
      "@type": "ica:Incident",
      "name": "CPU Spike — Missing DB Index After Deploy",
      "nodeType": "Incident",
      "ica:incident_id": "INC-3012",
      "ica:severity": "P1",
      "ica:status": "resolved",
      "ica:source_file": "INC-3012-CPU-MISSING-INDEX.md",
      "ica:on_call_engineer": "James Okafor",
      "ica:duration_minutes": 52,
      "ica:created_at": "2025-04-22T14:05:00Z",
      "ica:resolved_at": "2025-04-22T14:57:00Z",
      "ica:tags": "cpu,missing-index,database,deploy",
      "embeddingField": "Incident INC-3012. CPU Spike caused by missing DB index after deploy. Severity P1. Affected services: prod-db-02, Order Management API. Root cause: new query on orders table had no composite index. Resolution: added index on orders(user_id, created_at), deployed hotfix.",
      "TRIGGERED_BY":  "ica:alert-CriticalCPUUsage",
      "RESOLVED_BY":   "ica:RES-3012",
      "GUIDED_BY":     "ica:runbook-HIGH_CPU_RUNBOOK",
      "ESCALATES_TO":  "ica:P1-path",
      "AFFECTS":       "ica:system-prod-db-02",
      "SIMILAR_TO":    "ica:INC-2847"
    },

    {
      "@id": "ica:INC-3301",
      "@type": "ica:Incident",
      "name": "Connection Pool Exhaustion — 503 Errors",
      "nodeType": "Incident",
      "ica:incident_id": "INC-3301",
      "ica:severity": "P2",
      "ica:status": "resolved",
      "ica:source_file": "INC-3301-CONNECTION-POOL-EXHAUSTION.md",
      "ica:on_call_engineer": "Priya Nair",
      "ica:duration_minutes": 28,
      "ica:created_at": "2025-05-14T09:33:00Z",
      "ica:resolved_at": "2025-05-14T10:01:00Z",
      "ica:tags": "connection-pool,503,java,hikaricp",
      "embeddingField": "Incident INC-3301. Connection Pool Exhaustion causing 503 errors. Severity P2. Affected: Order Management API, prod-app-01. Root cause: connection.close() missing in catch block exhausted HikariCP pool. Resolution: rolled back deployment, fixed connection leak, redeployed.",
      "TRIGGERED_BY":  "ica:alert-DBConnectionPoolExhausted",
      "RESOLVED_BY":   "ica:RES-3301",
      "GUIDED_BY":     "ica:runbook-SERVICE_DOWN_RUNBOOK",
      "ESCALATES_TO":  "ica:P2-path",
      "AFFECTS":       "ica:system-Order-Management-API",
      "SIMILAR_TO":    "ica:INC-3601"
    },

    {
      "@id": "ica:INC-3455",
      "@type": "ica:Incident",
      "name": "Disk Full — Log Rotation Misconfiguration",
      "nodeType": "Incident",
      "ica:incident_id": "INC-3455",
      "ica:severity": "P3",
      "ica:status": "resolved",
      "ica:source_file": "INC-3455-DISK-FULL-LOGS.md",
      "ica:on_call_engineer": "Carlos Rivera",
      "ica:duration_minutes": 20,
      "ica:created_at": "2025-06-01T11:10:00Z",
      "ica:resolved_at": "2025-06-01T11:30:00Z",
      "ica:tags": "disk,logs,logrotate,os-upgrade",
      "embeddingField": "Incident INC-3455. Disk Full due to log rotation misconfiguration. Severity P3. Affected: prod-app-03. Root cause: OS upgrade removed logrotate config, 47GB logs accumulated. Resolution: manual logrotate, restored config from source control.",
      "TRIGGERED_BY":  "ica:alert-DiskSpaceCritical",
      "RESOLVED_BY":   "ica:RES-3455",
      "GUIDED_BY":     "ica:runbook-DISK_SPACE_RUNBOOK",
      "ESCALATES_TO":  "ica:P3-path",
      "AFFECTS":       "ica:system-prod-app-03"
    },

    {
      "@id": "ica:INC-3601",
      "@type": "ica:Incident",
      "name": "Payment Service Down — Bad Deployment Env Var",
      "nodeType": "Incident",
      "ica:incident_id": "INC-3601",
      "ica:severity": "P1",
      "ica:status": "resolved",
      "ica:source_file": "INC-3601-SERVICE-DOWN-BAD-DEPLOY.md",
      "ica:on_call_engineer": "Yuki Tanaka",
      "ica:incident_commander": "Priya Anand",
      "ica:duration_minutes": 12,
      "ica:created_at": "2025-07-22T16:03:00Z",
      "ica:resolved_at": "2025-07-22T16:15:00Z",
      "ica:tags": "payment,deploy,helm,kubernetes,env-var",
      "embeddingField": "Incident INC-3601. Payment Service Down due to bad Helm env var. Severity P1. Affected: Payment Service, Checkout Flow, Order Confirmation Service. Root cause: PAYMENT_GATEWAY_URL pointed to staging in production Helm values. Resolution: kubectl rollout undo, hotfix v4.2.1 deployed.",
      "TRIGGERED_BY":  "ica:alert-ServiceHealthCheckFail",
      "RESOLVED_BY":   "ica:RES-3601",
      "GUIDED_BY":     "ica:runbook-SERVICE_DOWN_RUNBOOK",
      "ESCALATES_TO":  "ica:P1-path",
      "AFFECTS":       "ica:system-Payment-Service",
      "SIMILAR_TO":    "ica:INC-3301"
    },

    {
      "@id": "ica:RES-2847",
      "@type": "ica:Resolution",
      "name": "Resolution for INC-2847",
      "nodeType": "Resolution",
      "ica:resolution_id": "RES-2847",
      "ica:incident_id": "INC-2847",
      "ica:root_cause": "Nightly batch job archive_orders_v2.sh executed a full-table-scan query against 400M-row orders table with no query timeout configured.",
      "ica:resolved_by": "Sarah Mitchell",
      "ica:resolved_at": "2025-06-10T02:49:00Z",
      "ica:duration_minutes": 35,
      "ica:lessons_learned": "All DB batch jobs must declare a query timeout before reaching production.",
      "embeddingField": "Resolution RES-2847 for INC-2847. Root cause: archive_orders_v2.sh ran without query timeout on 400M-row table. Steps: killed query via KILL pid, added max_statement_time=300, rescheduled cron to 04:00 UTC. Prevention: CI lint rule for batch scripts, PagerDuty alert for queries over 10 minutes.",
      "RESOLVES": "ica:INC-2847"
    },

    {
      "@id": "ica:RES-3012",
      "@type": "ica:Resolution",
      "name": "Resolution for INC-3012",
      "nodeType": "Resolution",
      "ica:resolution_id": "RES-3012",
      "ica:incident_id": "INC-3012",
      "ica:root_cause": "New feature deployment introduced a DB query on orders table without a composite index, causing full table scans under load.",
      "ica:resolved_by": "James Okafor",
      "ica:resolved_at": "2025-04-22T14:57:00Z",
      "ica:duration_minutes": 52,
      "ica:lessons_learned": "All DB migrations must be validated with EXPLAIN ANALYZE before deployment.",
      "embeddingField": "Resolution RES-3012 for INC-3012. Root cause: missing composite index on orders(user_id, created_at) caused full table scans. Steps: identified in slow query log, added index, deployed hotfix, confirmed CPU normalised. Prevention: EXPLAIN ANALYZE required in PR template.",
      "RESOLVES": "ica:INC-3012"
    },

    {
      "@id": "ica:RES-3301",
      "@type": "ica:Resolution",
      "name": "Resolution for INC-3301",
      "nodeType": "Resolution",
      "ica:resolution_id": "RES-3301",
      "ica:incident_id": "INC-3301",
      "ica:root_cause": "Connection leak introduced in exception handler — connection.close() missing in catch block, exhausting HikariCP pool.",
      "ica:resolved_by": "Priya Nair",
      "ica:resolved_at": "2025-05-14T10:01:00Z",
      "ica:duration_minutes": 28,
      "ica:lessons_learned": "All DB connection handling must use try-with-resources to guarantee close.",
      "embeddingField": "Resolution RES-3301 for INC-3301. Root cause: connection.close() missing in catch block exhausted HikariCP pool. Steps: identified from HikariCP metrics, rolled back deployment, fixed leak, redeployed. Prevention: static analysis rule for unclosed connections.",
      "RESOLVES": "ica:INC-3301"
    },

    {
      "@id": "ica:RES-3455",
      "@type": "ica:Resolution",
      "name": "Resolution for INC-3455",
      "nodeType": "Resolution",
      "ica:resolution_id": "RES-3455",
      "ica:incident_id": "INC-3455",
      "ica:root_cause": "OS upgrade silently removed logrotate drop-in config, causing 7 days of unrotated logs to accumulate on prod-app-03.",
      "ica:resolved_by": "Carlos Rivera",
      "ica:resolved_at": "2025-06-01T11:30:00Z",
      "ica:duration_minutes": 20,
      "ica:lessons_learned": "OS upgrade procedures must include a post-upgrade logrotate validation step.",
      "embeddingField": "Resolution RES-3455 for INC-3455. Root cause: OS upgrade removed logrotate config, 47GB accumulated. Steps: identified with du -sh, ran logrotate -f, freed 47GB, restored config from source control. Prevention: post-upgrade checklist includes logrotate verification.",
      "RESOLVES": "ica:INC-3455"
    },

    {
      "@id": "ica:RES-3601",
      "@type": "ica:Resolution",
      "name": "Resolution for INC-3601",
      "nodeType": "Resolution",
      "ica:resolution_id": "RES-3601",
      "ica:incident_id": "INC-3601",
      "ica:root_cause": "PAYMENT_GATEWAY_URL in Helm values.yaml pointed to staging instead of production, inherited during chart refactor.",
      "ica:resolved_by": "Yuki Tanaka",
      "ica:resolved_at": "2025-07-22T16:15:00Z",
      "ica:duration_minutes": 12,
      "ica:lessons_learned": "Production Helm values must never inherit from a shared base containing environment-specific URLs.",
      "embeddingField": "Resolution RES-3601 for INC-3601. Root cause: PAYMENT_GATEWAY_URL pointed to staging in production Helm values. Steps: identified from pod logs, confirmed staging URL in values.yaml diff, ran kubectl rollout undo, verified recovery, deployed v4.2.1 hotfix. Prevention: CI validates all production env vars.",
      "RESOLVES": "ica:INC-3601"
    },

    {
      "@id": "ica:runbook-HIGH_CPU_RUNBOOK",
      "@type": "ica:KnowledgeArticle",
      "name": "HIGH_CPU_RUNBOOK",
      "nodeType": "KnowledgeArticle",
      "ica:article_type": "runbook",
      "ica:source_file": "HIGH_CPU_RUNBOOK.md",
      "ica:owning_team": "Platform Operations",
      "ica:severity_coverage": "P1,P2",
      "ica:tags": "cpu,database,performance,production",
      "embeddingField": "HIGH_CPU_RUNBOOK. Runbook for high CPU alerts on production servers. Immediate actions: check top processes with ps aux, identify runaway queries with SHOW PROCESSLIST, kill offending process, notify team. Escalate if CPU remains above 90% for 30 minutes.",
      "TRIAGES":       "ica:alert-HighCPUUsage",
      "GOVERNED_BY":   "ica:P2-path",
      "COVERS_SYSTEM": "ica:system-prod-db-01"
    },

    {
      "@id": "ica:runbook-DISK_SPACE_RUNBOOK",
      "@type": "ica:KnowledgeArticle",
      "name": "DISK_SPACE_RUNBOOK",
      "nodeType": "KnowledgeArticle",
      "ica:article_type": "runbook",
      "ica:source_file": "DISK_SPACE_RUNBOOK.md",
      "ica:owning_team": "Infra SRE",
      "ica:severity_coverage": "P1,P2,P3",
      "ica:tags": "disk,logs,storage",
      "embeddingField": "DISK_SPACE_RUNBOOK. Runbook for disk space alerts. Immediate actions: run df -h to identify full volumes, du -sh /var/log/* to find large files, compress or delete old logs, run logrotate -f. Escalate if disk remains above 95% after cleanup.",
      "TRIAGES":       "ica:alert-DiskSpaceCritical",
      "GOVERNED_BY":   "ica:P2-path",
      "COVERS_SYSTEM": "ica:system-prod-app-03"
    },

    {
      "@id": "ica:runbook-SERVICE_DOWN_RUNBOOK",
      "@type": "ica:KnowledgeArticle",
      "name": "SERVICE_DOWN_RUNBOOK",
      "nodeType": "KnowledgeArticle",
      "ica:article_type": "runbook",
      "ica:source_file": "SERVICE_DOWN_RUNBOOK.md",
      "ica:owning_team": "App SRE",
      "ica:severity_coverage": "P1,P2",
      "ica:tags": "service,health,deploy,kubernetes",
      "embeddingField": "SERVICE_DOWN_RUNBOOK. Runbook for service health check failures and 503 errors. Immediate actions: check pod logs with kubectl logs, check recent deployments with kubectl rollout history, rollback with kubectl rollout undo if bad deploy confirmed. Escalate immediately for payment service.",
      "TRIAGES":       "ica:alert-ServiceHealthCheckFail",
      "GOVERNED_BY":   "ica:P1-path",
      "COVERS_SYSTEM": "ica:system-Payment-Service"
    },

    {
      "@id": "ica:runbook-NETWORK_LATENCY_RUNBOOK",
      "@type": "ica:KnowledgeArticle",
      "name": "NETWORK_LATENCY_RUNBOOK",
      "nodeType": "KnowledgeArticle",
      "ica:article_type": "runbook",
      "ica:source_file": "NETWORK_LATENCY_RUNBOOK.md",
      "ica:owning_team": "Network Ops",
      "ica:severity_coverage": "P2,P3",
      "ica:tags": "network,latency,packet-loss",
      "embeddingField": "NETWORK_LATENCY_RUNBOOK. Runbook for network latency spikes. Immediate actions: ping gateway, traceroute to affected host, check interface errors with netstat, check for packet loss. Escalate to Network Ops if latency exceeds 500ms P99 for more than 15 minutes.",
      "TRIAGES":       "ica:alert-NetworkLatencyHigh",
      "GOVERNED_BY":   "ica:P2-path"
    },

    {
