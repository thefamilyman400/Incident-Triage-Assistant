{
  "@context": {
    "@vocab": "https://schema.org/",
    "ica":   "https://ibm.com/consulting-advantage/context-studio/schema#",
    "shacl": "http://www.w3.org/ns/shacl#",
    "xsd":   "http://www.w3.org/2001/XMLSchema#"
  },

  "@id": "https://ibm.com/ica/graphs/IncidentTriageGraph",
  "@type": "ica:Graph",
  "schema:name": "IncidentTriageGraph",
  "schema:description": "Populated graph instance for IT Operations Support — concrete Nodes, Edges and Constraints ready for ICA Context Studio import.",
  "schema:version": "1.0.0",

  "@graph": [

    {
      "@comment": "================================================================",
      "@comment": "SECTION 1 — NODES",
      "@comment": "================================================================"
    },

    {
      "@id": "node:Incident",
      "@type": "ica:Node",
      "ica:nodeLabel": "Incident",
      "ica:nodeDescription": "A production infrastructure event requiring active triage and resolution.",
      "ica:color": "#cf222e",
      "ica:icon": "alert",
      "ica:properties": [
        { "name": "incident_id",        "type": "String",   "required": true,  "pattern": "^INC-[0-9]{4,}$",                                     "description": "Unique incident identifier",              "example": "INC-2847"                            },
        { "name": "title",              "type": "String",   "required": true,                                                                     "description": "Short incident title",                    "example": "Production DB CPU Spike"             },
        { "name": "content",            "type": "String",   "required": true,  "minLength": 200,  "embeddingField": true,                          "description": "Full post-mortem body — RAG search field","example": "Full post-mortem text..."            },
        { "name": "severity",           "type": "String",   "required": true,  "enum": ["P1","P2","P3","P4"],                                      "description": "Incident priority level",                 "example": "P2"                                  },
        { "name": "status",             "type": "String",   "required": true,  "enum": ["open","in-progress","resolved","monitoring"],             "description": "Current incident lifecycle state",        "example": "resolved"                            },
        { "name": "source_file",        "type": "String",   "required": true,  "pattern": "\\.(md|pdf|txt)$",                                     "description": "Source document filename",               "example": "INC-2847-HIGH-CPU-BATCH-JOB.md"      },
        { "name": "affected_services",  "type": "String[]", "required": true,                                                                     "description": "Impacted services or servers",            "example": ["Order Management API","prod-db-01"] },
        { "name": "on_call_engineer",   "type": "String",   "required": true,                                                                     "description": "Engineer who handled the incident",       "example": "Sarah Mitchell"                      },
        { "name": "incident_commander", "type": "String",   "required": false,                                                                    "description": "Incident commander for P1 bridge calls",  "example": "David Okafor"                        },
        { "name": "duration_minutes",   "type": "Integer",  "required": false, "minimum": 0,                                                      "description": "Total incident duration in minutes",      "example": 35                                    },
        { "name": "created_at",         "type": "DateTime", "required": true,                                                                     "description": "When the incident was first detected",    "example": "2025-06-10T02:14:00Z"                },
        { "name": "resolved_at",        "type": "DateTime", "required": false,                                                                    "description": "When the incident was resolved",          "example": "2025-06-10T02:49:00Z"                },
        { "name": "tags",               "type": "String[]", "required": false,                                                                    "description": "Keyword tags for filtering",              "example": ["cpu","batch-job","postgres"]         }
      ],
      "ica:instances": [
        {
          "incident_id": "INC-2847",
          "title": "Production DB CPU Spike — Runaway Batch Job",
          "severity": "P2",
          "status": "resolved",
          "source_file": "INC-2847-HIGH-CPU-BATCH-JOB.md",
          "affected_services": ["prod-db-01","Order Management API","Reporting Service"],
          "on_call_engineer": "Sarah Mitchell",
          "incident_commander": "David Okafor",
          "duration_minutes": 35,
          "created_at": "2025-06-10T02:14:00Z",
          "resolved_at": "2025-06-10T02:49:00Z",
          "tags": ["cpu","batch-job","database","postgres"]
        },
        {
          "incident_id": "INC-3012",
          "title": "CPU Spike — Missing DB Index After Deploy",
          "severity": "P1",
          "status": "resolved",
          "source_file": "INC-3012-CPU-MISSING-INDEX.md",
          "affected_services": ["prod-db-02","Order Management API"],
          "on_call_engineer": "James Okafor",
          "duration_minutes": 52,
          "created_at": "2025-04-22T14:05:00Z",
          "resolved_at": "2025-04-22T14:57:00Z",
          "tags": ["cpu","missing-index","database","deploy"]
        },
        {
          "incident_id": "INC-3301",
          "title": "Connection Pool Exhaustion — 503 Errors",
          "severity": "P2",
          "status": "resolved",
          "source_file": "INC-3301-CONNECTION-POOL-EXHAUSTION.md",
          "affected_services": ["Order Management API","prod-app-01"],
          "on_call_engineer": "Priya Nair",
          "duration_minutes": 28,
          "created_at": "2025-05-14T09:33:00Z",
          "resolved_at": "2025-05-14T10:01:00Z",
          "tags": ["connection-pool","503","java","hikaricp"]
        },
        {
          "incident_id": "INC-3455",
          "title": "Disk Full — Log Rotation Misconfiguration",
          "severity": "P3",
          "status": "resolved",
          "source_file": "INC-3455-DISK-FULL-LOGS.md",
          "affected_services": ["prod-app-03"],
          "on_call_engineer": "Carlos Rivera",
          "duration_minutes": 20,
          "created_at": "2025-06-01T11:10:00Z",
          "resolved_at": "2025-06-01T11:30:00Z",
          "tags": ["disk","logs","logrotate","os-upgrade"]
        },
        {
          "incident_id": "INC-3601",
          "title": "Payment Service Down — Bad Deployment Env Var",
          "severity": "P1",
          "status": "resolved",
          "source_file": "INC-3601-SERVICE-DOWN-BAD-DEPLOY.md",
          "affected_services": ["Payment Service","Checkout Flow","Order Confirmation Service"],
          "on_call_engineer": "Yuki Tanaka",
          "incident_commander": "Priya Anand",
          "duration_minutes": 12,
          "created_at": "2025-07-22T16:03:00Z",
          "resolved_at": "2025-07-22T16:15:00Z",
          "tags": ["payment","deploy","helm","kubernetes","env-var"]
        }
      ]
    },

    {
      "@id": "node:Resolution",
      "@type": "ica:Node",
      "ica:nodeLabel": "Resolution",
      "ica:nodeDescription": "Documented root cause, fix steps and follow-up actions for a closed incident.",
      "ica:color": "#2da44e",
      "ica:icon": "checkmark",
      "ica:properties": [
        { "name": "resolution_id",       "type": "String",   "required": true,  "pattern": "^RES-[0-9]{4,}$",  "description": "Unique resolution identifier",                "example": "RES-2847"                                     },
        { "name": "incident_id",         "type": "String",   "required": true,  "pattern": "^INC-[0-9]{4,}$",  "description": "Foreign key to the parent Incident node",     "example": "INC-2847"                                     },
        { "name": "root_cause",          "type": "String",   "required": true,  "minLength": 50,                "description": "Verified root cause of the incident",         "example": "Batch job ran without query timeout"           },
        { "name": "resolution_steps",    "type": "String[]", "required": true,  "minItems": 1,                  "description": "Ordered list of steps taken to resolve",      "example": ["Killed query","Added timeout","Rescheduled"]  },
        { "name": "action_items",        "type": "String[]", "required": false,                                 "description": "Follow-up Jira tickets and tasks",            "example": ["PLAT-4401","DB-892"]                         },
        { "name": "lessons_learned",     "type": "String",   "required": false,                                 "description": "Key learnings to prevent recurrence",        "example": "Batch jobs must declare a query timeout"       },
        { "name": "resolved_by",         "type": "String",   "required": true,                                  "description": "Engineer who resolved the incident",         "example": "Sarah Mitchell"                               },
        { "name": "resolved_at",         "type": "DateTime", "required": true,                                  "description": "Timestamp of resolution",                    "example": "2025-06-10T02:49:00Z"                         },
        { "name": "duration_minutes",    "type": "Integer",  "required": true,  "minimum": 0,                   "description": "Time from alert to resolution",               "example": 35                                             },
        { "name": "prevention_measures", "type": "String[]", "required": false,                                 "description": "Controls implemented to prevent recurrence", "example": ["CI lint rule","Observability alert"]          }
      ],
      "ica:instances": [
        {
          "resolution_id": "RES-2847", "incident_id": "INC-2847",
          "root_cause": "Nightly batch job archive_orders_v2.sh executed a full-table-scan query against 400M-row orders table with no query timeout configured.",
          "resolution_steps": ["Identified runaway process via SHOW PROCESSLIST","Terminated long-running query with KILL <pid>","Added SET SESSION max_statement_time=300 to batch script","Rescheduled cron from 01:30 UTC to 04:00 UTC"],
          "action_items": ["PLAT-4401: Add timeout to all batch scripts","DB-892: Index on orders.archived_at","PLAT-4402: Reschedule archival cron","OBS-210: Alert for queries > 10 min"],
          "lessons_learned": "All DB batch jobs must declare a query timeout before reaching production.",
          "resolved_by": "Sarah Mitchell", "resolved_at": "2025-06-10T02:49:00Z", "duration_minutes": 35,
          "prevention_measures": ["CI lint rule for batch scripts without timeout","PagerDuty alert for queries running > 10 minutes"]
        },
        {
          "resolution_id": "RES-3012", "incident_id": "INC-3012",
          "root_cause": "New feature deployment introduced a DB query on orders table without a composite index, causing full table scans under load.",
          "resolution_steps": ["Identified full table scan in slow query log","Added composite index on orders(user_id, created_at)","Deployed hotfix to production","Confirmed CPU normalised on monitoring"],
          "action_items": ["DB-901: Enforce EXPLAIN check in PR review","CICD-290: Add DB migration validator to pipeline"],
          "lessons_learned": "All DB migrations must be validated with EXPLAIN ANALYZE before deployment.",
          "resolved_by": "James Okafor", "resolved_at": "2025-04-22T14:57:00Z", "duration_minutes": 52,
          "prevention_measures": ["Required EXPLAIN ANALYZE in PR template","Slow query threshold alert added"]
        },
        {
          "resolution_id": "RES-3301", "incident_id": "INC-3301",
          "root_cause": "Connection leak introduced in exception handler — connection.close() missing in catch block, exhausting HikariCP pool.",
          "resolution_steps": ["Identified pool exhaustion from HikariCP metrics","Rolled back deployment to previous version","Fixed connection.close() in catch block","Redeployed with fix"],
          "action_items": ["PLAT-4410: Add connection leak detection to code review checklist","OBS-215: Alert on HikariCP pool > 80%"],
          "lessons_learned": "All DB connection handling must use try-with-resources to guarantee close.",
          "resolved_by": "Priya Nair", "resolved_at": "2025-05-14T10:01:00Z", "duration_minutes": 28,
          "prevention_measures": ["Static analysis rule for unclosed connections","HikariCP leak detection enabled in staging"]
        },
        {
          "resolution_id": "RES-3455", "incident_id": "INC-3455",
          "root_cause": "OS upgrade silently removed logrotate drop-in config for application logs, causing 7 days of unrotated logs to accumulate.",
          "resolution_steps": ["Identified large log files with du -sh /var/log/*","Manually rotated logs with logrotate -f","Freed 47 GB disk space","Restored logrotate config from source control","Verified service recovery"],
          "action_items": ["INFRA-5901: Add logrotate config to OS upgrade checklist","OBS-220: Alert if logrotate has not run in 24 hours"],
          "lessons_learned": "OS upgrade procedures must include a post-upgrade logrotate validation step.",
          "resolved_by": "Carlos Rivera", "resolved_at": "2025-06-01T11:30:00Z", "duration_minutes": 20,
          "prevention_measures": ["Post-upgrade checklist includes logrotate verification","Daily logrotate success alert added"]
        },
        {
          "resolution_id": "RES-3601", "incident_id": "INC-3601",
          "root_cause": "Misconfigured PAYMENT_GATEWAY_URL in Helm values.yaml pointed to staging gateway instead of production, inherited during chart refactor.",
          "resolution_steps": ["Identified crash from pod logs: invalid PAYMENT_GATEWAY_URL","Confirmed staging URL in values.yaml diff","Ran kubectl rollout undo deployment/payment-service","Verified recovery on pod logs and Stripe dashboard","Deployed v4.2.1 hotfix with corrected config"],
          "action_items": ["INFRA-6101: Separate env-specific values into values-<env>.yaml","CICD-330: CI validation for required prod env vars","PAY-1142: Startup probe for payment gateway connectivity","CICD-331: Auto-diff check for staging URLs in prod manifests"],
          "lessons_learned": "Production Helm values must never inherit from a shared base that includes environment-specific URLs.",
          "resolved_by": "Yuki Tanaka", "resolved_at": "2025-07-22T16:15:00Z", "duration_minutes": 12,
          "prevention_measures": ["CI step validates all production env vars","Automated diff check for staging URLs in production manifests"]
        }
      ]
    },

    {
      "@id": "node:KnowledgeArticle",
      "@type": "ica:Node",
      "ica:nodeLabel": "KnowledgeArticle",
      "ica:nodeDescription": "Runbooks, alert definitions, and escalation policies — the RAG-searchable operational knowledge base.",
      "ica:color": "#3b82d4",
      "ica:icon": "document",
      "ica:properties": [
        { "name": "title",               "type": "String",   "required": true,                                                                              "description": "Article title / runbook name",          "example": "HIGH_CPU_RUNBOOK"            },
        { "name": "content",             "type": "String",   "required": true,  "minLength": 200, "embeddingField": true,                                    "description": "Full article body — RAG search field", "example": "Full runbook text..."        },
        { "name": "article_type",        "type": "String",   "required": true,  "enum": ["runbook","policy","alert"],                                        "description": "Document category",                    "example": "runbook"                     },
        { "name": "source_file",         "type": "String",   "required": true,  "pattern": "\\.(md|pdf|txt)$",                                              "description": "Source filename for citation",         "example": "HIGH_CPU_RUNBOOK.md"         },
        { "name": "version",             "type": "String",   "required": false,                                                                             "description": "Document version",                     "example": "3.1"                         },
        { "name": "owning_team",         "type": "String",   "required": true,  "enum": ["Infra SRE","App SRE","Database Ops","Network Ops","Platform SRE","Infrastructure Operations","Platform Operations"], "description": "Team responsible for this article", "example": "Platform Operations" },
        { "name": "severity_coverage",   "type": "String[]", "required": false, "items_enum": ["P1","P2","P3","P4"],                                         "description": "Severity levels this article covers",  "example": ["P1","P2"]                   },
        { "name": "diagnostic_commands", "type": "String[]", "required": false,                                                                             "description": "Shell/SQL commands for diagnosis",     "example": ["ps aux --sort=-%cpu"]       },
        { "name": "escalation_criteria", "type": "String[]", "required": false,                                                                             "description": "When to escalate per this runbook",    "example": ["CPU > 90% for 30 min"]      },
        { "name": "tags",                "type": "String[]", "required": false,                                                                             "description": "Keyword tags",                         "example": ["cpu","database"]            },
        { "name": "updated_at",          "type": "DateTime", "required": false,                                                                             "description": "Last reviewed — used for staleness",   "example": "2024-11-14T00:00:00Z"        }
      ],
      "ica:instances": [
        { "title": "HIGH_CPU_RUNBOOK",          "article_type": "runbook", "source_file": "HIGH_CPU_RUNBOOK.md",          "owning_team": "Platform Operations", "severity_coverage": ["P1","P2"], "version": "3.1",  "tags": ["cpu","database","performance"], "updated_at": "2024-11-14T00:00:00Z" },
        { "title": "DISK_SPACE_RUNBOOK",        "article_type": "runbook", "source_file": "DISK_SPACE_RUNBOOK.md",        "owning_team": "Infra SRE",           "severity_coverage": ["P1","P2","P3"], "tags": ["disk","logs","storage"],  "updated_at": "2024-10-01T00:00:00Z" },
        { "title": "SERVICE_DOWN_RUNBOOK",      "article_type": "runbook", "source_file": "SERVICE_DOWN_RUNBOOK.md",      "owning_team": "App SRE",             "severity_coverage": ["P1","P2"], "tags": ["service","health","deploy","kubernetes"], "updated_at": "2024-11-01T00:00:00Z" },
        { "title": "NETWORK_LATENCY_RUNBOOK",   "article_type": "runbook", "source_file": "NETWORK_LATENCY_RUNBOOK.md",   "owning_team": "Network Ops",         "severity_coverage": ["P2","P3"], "tags": ["network","latency","packet-loss"],        "updated_at": "2024-09-01T00:00:00Z" },
        { "title": "ESCALATION_POLICY",         "article_type": "policy",  "source_file": "ESCALATION_POLICY.md",         "owning_team": "Infrastructure Operations", "tags": ["escalation","on-call","P1","P2","sla"], "updated_at": "2024-10-01T00:00:00Z" },
        { "title": "ALERT_DEFINITIONS",         "article_type": "alert",   "source_file": "ALERT_DEFINITIONS.md",         "owning_team": "Infra SRE",           "tags": ["alerts","thresholds","routing"],          "updated_at": "2024-11-01T00:00:00Z" },
        { "title": "HighCPUUsage",              "article_type": "alert",   "source_file": "ALERT_DEFINITIONS.md",         "owning_team": "Infra SRE",           "severity_coverage": ["P2"], "tags": ["cpu","prometheus"] },
        { "title": "CriticalCPUUsage",          "article_type": "alert",   "source_file": "ALERT_DEFINITIONS.md",         "owning_team": "Infra SRE",           "severity_coverage": ["P1"], "tags": ["cpu","prometheus"] },
        { "title": "DiskSpaceCritical",         "article_type": "alert",   "source_file": "ALERT_DEFINITIONS.md",         "owning_team": "Infra SRE",           "severity_coverage": ["P1"], "tags": ["disk","storage"] },
        { "title": "ServiceHealthCheckFail",    "article_type": "alert",   "source_file": "ALERT_DEFINITIONS.md",         "owning_team": "App SRE",             "severity_coverage": ["P1"], "tags": ["health","service"] },
        { "title": "DBConnectionPoolExhausted", "article_type": "alert",   "source_file": "ALERT_DEFINITIONS.md",         "owning_team": "Database Ops",        "severity_coverage": ["P1"], "tags": ["database","connection-pool"] },
        { "title": "K8sPodCrashLooping",        "article_type": "alert",   "source_file": "ALERT_DEFINITIONS.md",         "owning_team": "Platform SRE",        "severity_coverage": ["P1"], "tags": ["kubernetes","pod","crashloop"] }
      ]
    },

    {
      "@id": "node:System",
      "@type": "ica:Node",
      "ica:nodeLabel": "System",
      "ica:nodeDescription": "A named infrastructure service, server, or platform component.",
      "ica:color": "#e6a700",
      "ica:icon": "server",
      "ica:properties": [
        { "name": "system_id",         "type": "String",   "required": true,                                                                           "description": "Unique system identifier",       "example": "prod-db-01"        },
        { "name": "display_name",      "type": "String",   "required": true,                                                                           "description": "Human-readable name",            "example": "Order Management API" },
        { "name": "system_type",       "type": "String",   "required": true,  "enum": ["database","application","platform","network","queue","other"],  "description": "System category",                "example": "database"          },
        { "name": "environment",       "type": "String",   "required": true,  "enum": ["production","staging","development"],                           "description": "Deployment environment",         "example": "production"        },
        { "name": "owning_team",       "type": "String",   "required": true,                                                                           "description": "Team responsible for the system","example": "Database Ops"      },
        { "name": "pagerduty_service", "type": "String",   "required": false,                                                                          "description": "PagerDuty routing service",      "example": "db-oncall"         },
        { "name": "slack_channel",     "type": "String",   "required": false,                                                                          "description": "Alert Slack channel",            "example": "#db-alerts"        },
        { "name": "tags",              "type": "String[]", "required": false,                                                                          "description": "Keyword tags",                   "example": ["postgres","primary"] }
      ],
      "ica:instances": [
        { "system_id": "prod-db-01",                 "display_name": "Primary Production Database",      "system_type": "database",    "environment": "production", "owning_team": "Database Ops",    "pagerduty_service": "db-oncall",      "slack_channel": "#db-alerts",       "tags": ["postgres","primary","orders"] },
        { "system_id": "prod-db-02",                 "display_name": "Secondary Production Database",    "system_type": "database",    "environment": "production", "owning_team": "Database Ops",    "pagerduty_service": "db-oncall",      "slack_channel": "#db-alerts",       "tags": ["postgres","secondary"] },
        { "system_id": "prod-app-01",                "display_name": "Production App Server 01",         "system_type": "application", "environment": "production", "owning_team": "App SRE",         "pagerduty_service": "infra-oncall",   "slack_channel": "#infra-alerts",    "tags": ["app","api"] },
        { "system_id": "prod-app-03",                "display_name": "Production App Server 03",         "system_type": "application", "environment": "production", "owning_team": "App SRE",         "pagerduty_service": "infra-oncall",   "slack_channel": "#infra-alerts",    "tags": ["app","logs"] },
        { "system_id": "Order Management API",       "display_name": "Order Management API",             "system_type": "application", "environment": "production", "owning_team": "Platform SRE",    "pagerduty_service": "infra-oncall",   "slack_channel": "#infra-alerts",    "tags": ["orders","api","p99-sla"] },
        { "system_id": "Reporting Service",          "display_name": "Reporting Service",                "system_type": "application", "environment": "production", "owning_team": "App SRE",         "pagerduty_service": "infra-oncall",   "slack_channel": "#infra-alerts",    "tags": ["reporting","analytics"] },
        { "system_id": "Payment Service",            "display_name": "Payment Service",                  "system_type": "application", "environment": "production", "owning_team": "Platform SRE",    "pagerduty_service": "infra-oncall",   "slack_channel": "#incidents-p1",    "tags": ["payments","stripe","critical"] },
        { "system_id": "Checkout Flow",              "display_name": "Checkout Flow",                    "system_type": "application", "environment": "production", "owning_team": "Platform SRE",    "pagerduty_service": "infra-oncall",   "slack_channel": "#incidents-p1",    "tags": ["checkout","payments","critical"] },
        { "system_id": "Order Confirmation Service", "display_name": "Order Confirmation Service",       "system_type": "application", "environment": "production", "owning_team": "App SRE",         "pagerduty_service": "infra-oncall",   "slack_channel": "#infra-alerts",    "tags": ["orders","confirmation"] }
      ]
    },

    {
      "@id": "node:EscalationPath",
      "@type": "ica:Node",
      "ica:nodeLabel": "EscalationPath",
      "ica:nodeDescription": "Who gets paged, when, and through which channel per severity level.",
      "ica:color": "#7c5cd8",
      "ica:icon": "escalate",
      "ica:properties": [
        { "name": "path_id",              "type": "String",              "required": true,  "enum": ["P1-path","P2-path","P3-path","P4-path"], "description": "Unique escalation path identifier",       "example": "P1-path"         },
        { "name": "severity",             "type": "String",              "required": true,  "enum": ["P1","P2","P3","P4"],                     "description": "Severity this path governs",              "example": "P1"              },
        { "name": "initial_response_sla", "type": "String",              "required": true,                                                    "description": "Time-to-acknowledge SLA",                 "example": "≤ 5 minutes"     },
        { "name": "resolution_target",    "type": "String",              "required": true,                                                    "description": "Time-to-resolve target",                  "example": "≤ 2 hours"       },
        { "name": "pagerduty_service",    "type": "String",              "required": true,                                                    "description": "PagerDuty service name for routing",      "example": "infra-oncall"    },
        { "name": "slack_channel",        "type": "String",              "required": true,                                                    "description": "Slack channel for live updates",          "example": "#incidents-p1"   },
        { "name": "bridge_call_required", "type": "Boolean",             "required": true,                                                    "description": "Whether a bridge call must be opened",    "example": true              },
        { "name": "steps",                "type": "EscalationStep[]",    "required": true,  "minItems": 1,                                    "description": "Chronological escalation actions",        "example": "See instances"   }
      ],
      "ica:instances": [
        {
          "path_id": "P1-path", "severity": "P1",
          "initial_response_sla": "≤ 5 minutes", "resolution_target": "≤ 2 hours",
          "pagerduty_service": "infra-oncall", "slack_channel": "#incidents-p1",
          "bridge_call_required": true,
          "steps": [
            { "at_minutes": 0,   "action": "Primary on-call acknowledges PagerDuty alert",            "owner": "Primary On-Call"    },
            { "at_minutes": 5,   "action": "Secondary on-call paged if unacknowledged",               "owner": "PagerDuty (auto)"   },
            { "at_minutes": 10,  "action": "Open bridge call; post in #incidents-p1",                 "owner": "Primary On-Call"    },
            { "at_minutes": 15,  "action": "Notify Escalation Manager via direct page",               "owner": "Primary On-Call"    },
            { "at_minutes": 30,  "action": "Escalation Manager engages VP Engineering",               "owner": "Escalation Manager" },
            { "at_minutes": 60,  "action": "Executive stakeholder notification if no ETA",            "owner": "VP Engineering"     },
            { "at_minutes": 120, "action": "Incident review initiated if still unresolved",           "owner": "Escalation Manager" }
          ]
        },
        {
          "path_id": "P2-path", "severity": "P2",
          "initial_response_sla": "≤ 15 minutes", "resolution_target": "≤ 4 hours",
          "pagerduty_service": "infra-oncall", "slack_channel": "#incidents-p2",
          "bridge_call_required": false,
          "steps": [
            { "at_minutes": 0,   "action": "Primary on-call acknowledges PagerDuty alert",            "owner": "Primary On-Call"    },
            { "at_minutes": 15,  "action": "Secondary on-call paged if unacknowledged",               "owner": "PagerDuty (auto)"   },
            { "at_minutes": 30,  "action": "Post status update in #incidents-p2",                     "owner": "Primary On-Call"    },
            { "at_minutes": 60,  "action": "Notify Escalation Manager if no resolution path found",   "owner": "Primary On-Call"    },
            { "at_minutes": 120, "action": "Auto-promote to P1 if unresolved",                        "owner": "Escalation Manager" }
          ]
        },
        {
          "path_id": "P3-path", "severity": "P3",
          "initial_response_sla": "≤ 1 hour (business hours)", "resolution_target": "≤ 24 hours",
          "pagerduty_service": "infra-oncall", "slack_channel": "#infra-oncall",
          "bridge_call_required": false,
          "steps": [
            { "at_minutes": 60, "action": "Acknowledge during business hours; post in #infra-oncall", "owner": "Primary On-Call" }
          ]
        },
        {
          "path_id": "P4-path", "severity": "P4",
          "initial_response_sla": "≤ 1 business day", "resolution_target": "Next sprint",
          "pagerduty_service": null, "slack_channel": "#infra-oncall",
          "bridge_call_required": false,
          "steps": [
            { "at_minutes": 480, "action": "Jira ticket created and triaged next business day",       "owner": "On-Call Engineer" }
          ]
        }
      ]
    },

    {
      "@comment": "================================================================",
      "@comment": "SECTION 2 — EDGES (Relationships between node instances)",
      "@comment": "================================================================"
    },

    { "@id": "edge:INC-2847-triggeredBy-HighCPUUsage",       "@type": "ica:Edge", "ica:label": "TRIGGERED_BY",  "ica:from": "INC-2847",                "ica:fromNode": "node:Incident",         "ica:to": "HighCPUUsage",              "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:INC-3012-triggeredBy-HighCPUUsage",       "@type": "ica:Edge", "ica:label": "TRIGGERED_BY",  "ica:from": "INC-3012",                "ica:fromNode": "node:Incident",         "ica:to": "HighCPUUsage",              "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:INC-3301-triggeredBy-DBConnPool",         "@type": "ica:Edge", "ica:label": "TRIGGERED_BY",  "ica:from": "INC-3301",                "ica:fromNode": "node:Incident",         "ica:to": "DBConnectionPoolExhausted", "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:INC-3455-triggeredBy-DiskSpaceCritical",  "@type": "ica:Edge", "ica:label": "TRIGGERED_BY",  "ica:from": "INC-3455",                "ica:fromNode": "node:Incident",         "ica:to": "DiskSpaceCritical",         "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:INC-3601-triggeredBy-ServiceHealthFail",  "@type": "ica:Edge", "ica:label": "TRIGGERED_BY",  "ica:from": "INC-3601",                "ica:fromNode": "node:Incident",         "ica:to": "ServiceHealthCheckFail",    "ica:toNode": "node:KnowledgeArticle" },

    { "@id": "edge:INC-2847-resolvedBy-RES-2847",            "@type": "ica:Edge", "ica:label": "RESOLVED_BY",   "ica:from": "INC-2847",                "ica:fromNode": "node:Incident",         "ica:to": "RES-2847",                  "ica:toNode": "node:Resolution" },
    { "@id": "edge:INC-3012-resolvedBy-RES-3012",            "@type": "ica:Edge", "ica:label": "RESOLVED_BY",   "ica:from": "INC-3012",                "ica:fromNode": "node:Incident",         "ica:to": "RES-3012",                  "ica:toNode": "node:Resolution" },
    { "@id": "edge:INC-3301-resolvedBy-RES-3301",            "@type": "ica:Edge", "ica:label": "RESOLVED_BY",   "ica:from": "INC-3301",                "ica:fromNode": "node:Incident",         "ica:to": "RES-3301",                  "ica:toNode": "node:Resolution" },
    { "@id": "edge:INC-3455-resolvedBy-RES-3455",            "@type": "ica:Edge", "ica:label": "RESOLVED_BY",   "ica:from": "INC-3455",                "ica:fromNode": "node:Incident",         "ica:to": "RES-3455",                  "ica:toNode": "node:Resolution" },
    { "@id": "edge:INC-3601-resolvedBy-RES-3601",            "@type": "ica:Edge", "ica:label": "RESOLVED_BY",   "ica:from": "INC-3601",                "ica:fromNode": "node:Incident",         "ica:to": "RES-3601",                  "ica:toNode": "node:Resolution" },

    { "@id": "edge:INC-2847-guidedBy-HighCPU-Runbook",       "@type": "ica:Edge", "ica:label": "GUIDED_BY",     "ica:from": "INC-2847",                "ica:fromNode": "node:Incident",         "ica:to": "HIGH_CPU_RUNBOOK",          "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:INC-3012-guidedBy-HighCPU-Runbook",       "@type": "ica:Edge", "ica:label": "GUIDED_BY",     "ica:from": "INC-3012",                "ica:fromNode": "node:Incident",         "ica:to": "HIGH_CPU_RUNBOOK",          "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:INC-3301-guidedBy-ServiceDown-Runbook",   "@type": "ica:Edge", "ica:label": "GUIDED_BY",     "ica:from": "INC-3301",                "ica:fromNode": "node:Incident",         "ica:to": "SERVICE_DOWN_RUNBOOK",      "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:INC-3455-guidedBy-DiskSpace-Runbook",     "@type": "ica:Edge", "ica:label": "GUIDED_BY",     "ica:from": "INC-3455",                "ica:fromNode": "node:Incident",         "ica:to": "DISK_SPACE_RUNBOOK",        "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:INC-3601-guidedBy-ServiceDown-Runbook",   "@type": "ica:Edge", "ica:label": "GUIDED_BY",     "ica:from": "INC-3601",                "ica:fromNode": "node:Incident",         "ica:to": "SERVICE_DOWN_RUNBOOK",      "ica:toNode": "node:KnowledgeArticle" },

    { "@id": "edge:INC-2847-affects-prod-db-01",             "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-2847",                "ica:fromNode": "node:Incident",         "ica:to": "prod-db-01",                "ica:toNode": "node:System" },
    { "@id": "edge:INC-2847-affects-OrderMgmtAPI",           "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-2847",                "ica:fromNode": "node:Incident",         "ica:to": "Order Management API",      "ica:toNode": "node:System" },
    { "@id": "edge:INC-2847-affects-ReportingService",       "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-2847",                "ica:fromNode": "node:Incident",         "ica:to": "Reporting Service",         "ica:toNode": "node:System" },
    { "@id": "edge:INC-3012-affects-prod-db-02",             "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-3012",                "ica:fromNode": "node:Incident",         "ica:to": "prod-db-02",                "ica:toNode": "node:System" },
    { "@id": "edge:INC-3301-affects-OrderMgmtAPI",           "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-3301",                "ica:fromNode": "node:Incident",         "ica:to": "Order Management API",      "ica:toNode": "node:System" },
    { "@id": "edge:INC-3455-affects-prod-app-03",            "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-3455",                "ica:fromNode": "node:Incident",         "ica:to": "prod-app-03",               "ica:toNode": "node:System" },
    { "@id": "edge:INC-3601-affects-PaymentService",         "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-3601",                "ica:fromNode": "node:Incident",         "ica:to": "Payment Service",           "ica:toNode": "node:System" },
    { "@id": "edge:INC-3601-affects-CheckoutFlow",           "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-3601",                "ica:fromNode": "node:Incident",         "ica:to": "Checkout Flow",             "ica:toNode": "node:System" },
    { "@id": "edge:INC-3601-affects-OrderConfirmation",      "@type": "ica:Edge", "ica:label": "AFFECTS",       "ica:from": "INC-3601",                "ica:fromNode": "node:Incident",         "ica:to": "Order Confirmation Service", "ica:toNode": "node:System" },

    { "@id": "edge:INC-2847-similarTo-INC-3012",             "@type": "ica:Edge", "ica:label": "SIMILAR_TO",    "ica:from": "INC-2847",                "ica:fromNode": "node:Incident",         "ica:to": "INC-3012",                  "ica:toNode": "node:Incident",        "ica:bidirectional": true },
    { "@id": "edge:INC-3301-similarTo-INC-3601",             "@type": "ica:Edge", "ica:label": "SIMILAR_TO",    "ica:from": "INC-3301",                "ica:fromNode": "node:Incident",         "ica:to": "INC-3601",                  "ica:toNode": "node:Incident",        "ica:bidirectional": true },

    { "@id": "edge:INC-2847-escalatesTo-P2-path",            "@type": "ica:Edge", "ica:label": "ESCALATES_TO",  "ica:from": "INC-2847",                "ica:fromNode": "node:Incident",         "ica:to": "P2-path",                   "ica:toNode": "node:EscalationPath" },
    { "@id": "edge:INC-3012-escalatesTo-P1-path",            "@type": "ica:Edge", "ica:label": "ESCALATES_TO",  "ica:from": "INC-3012",                "ica:fromNode": "node:Incident",         "ica:to": "P1-path",                   "ica:toNode": "node:EscalationPath" },
    { "@id": "edge:INC-3301-escalatesTo-P2-path",            "@type": "ica:Edge", "ica:label": "ESCALATES_TO",  "ica:from": "INC-3301",                "ica:fromNode": "node:Incident",         "ica:to": "P2-path",                   "ica:toNode": "node:EscalationPath" },
    { "@id": "edge:INC-3455-escalatesTo-P3-path",            "@type": "ica:Edge", "ica:label": "ESCALATES_TO",  "ica:from": "INC-3455",                "ica:fromNode": "node:Incident",         "ica:to": "P3-path",                   "ica:toNode": "node:EscalationPath" },
    { "@id": "edge:INC-3601-escalatesTo-P1-path",            "@type": "ica:Edge", "ica:label": "ESCALATES_TO",  "ica:from": "INC-3601",                "ica:fromNode": "node:Incident",         "ica:to": "P1-path",                   "ica:toNode": "node:EscalationPath" },

    { "@id": "edge:HighCPU-runbook-triages-HighCPUUsage",    "@type": "ica:Edge", "ica:label": "TRIAGES",       "ica:from": "HIGH_CPU_RUNBOOK",        "ica:fromNode": "node:KnowledgeArticle", "ica:to": "HighCPUUsage",              "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:HighCPU-runbook-triages-CriticalCPU",     "@type": "ica:Edge", "ica:label": "TRIAGES",       "ica:from": "HIGH_CPU_RUNBOOK",        "ica:fromNode": "node:KnowledgeArticle", "ica:to": "CriticalCPUUsage",          "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:DiskSpace-runbook-triages-DiskCritical",  "@type": "ica:Edge", "ica:label": "TRIAGES",       "ica:from": "DISK_SPACE_RUNBOOK",      "ica:fromNode": "node:KnowledgeArticle", "ica:to": "DiskSpaceCritical",         "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:ServiceDown-runbook-triages-HealthFail",  "@type": "ica:Edge", "ica:label": "TRIAGES",       "ica:from": "SERVICE_DOWN_RUNBOOK",    "ica:fromNode": "node:KnowledgeArticle", "ica:to": "ServiceHealthCheckFail",    "ica:toNode": "node:KnowledgeArticle" },
    { "@id": "edge:ServiceDown-runbook-triages-CrashLoop",   "@type": "ica:Edge", "ica:label": "TRIAGES",       "ica:from": "SERVICE_DOWN_RUNBOOK",    "ica:fromNode": "node:KnowledgeArticle", "ica:to": "K8sPodCrashLooping",        "ica:toNode": "node:KnowledgeArticle" },

    { "@id": "edge:HighCPU-runbook-governedBy-EscPolicy",   "@type": "ica:Edge", "ica:label": "GOVERNED_BY",    "ica:from": "HIGH_CPU_RUNBOOK",        "ica:fromNode": "node:KnowledgeArticle", "ica:to": "P2-path",                   "ica:toNode": "node:EscalationPath" },
    { "@id": "edge:DiskSpace-runbook-governedBy-EscPolicy", "@type": "ica:Edge", "ica:label": "GOVERNED_BY",    "ica:from": "DISK_SPACE_RUNBOOK",      "ica:fromNode": "node:KnowledgeArticle", "ica:to": "P2-path",                   "ica:toNode": "node:EscalationPath" },
    { "@id": "edge:ServiceDown-runbook-governedBy-P1",      "@type": "ica:Edge", "ica:label": "GOVERNED_BY",    "ica:from": "SERVICE_DOWN_RUNBOOK",    "ica:fromNode": "node:KnowledgeArticle", "ica:to": "P1-path",                   "ica:toNode": "node:EscalationPath" },
    { "@id": "edge:Network-runbook-governedBy-P2",          "@type": "ica:Edge", "ica:label": "GOVERNED_BY",    "ica:from": "NETWORK_LATENCY_RUNBOOK", "ica:fromNode": "node:KnowledgeArticle", "ica:to": "P2-path",                   "ica:toNode": "node:EscalationPath" },

    { "@id": "edge:HighCPU-runbook-covers-prod-db-01",      "@type": "ica:Edge", "ica:label": "COVERS_SYSTEM",  "ica:from": "HIGH_CPU_RUNBOOK",        "ica:fromNode": "node:KnowledgeArticle", "ica:to": "prod-db-01",                "ica:toNode": "node:System" },
    { "@id": "edge:HighCPU-runbook-covers-prod-db-02",      "@type": "ica:Edge", "ica:label": "COVERS_SYSTEM",  "ica:from": "HIGH_CPU_RUNBOOK",        "ica:fromNode": "node:KnowledgeArticle", "ica:to": "prod-db-02",                "ica:toNode": "node:System" },
    { "@id": "edge:DiskSpace-runbook-covers-prod-app-03",   "@type": "ica:Edge", "ica:label": "COVERS_SYSTEM",  "ica:from": "DISK_SPACE_RUNBOOK",      "ica:fromNode": "node:KnowledgeArticle", "ica:to": "prod-app-03",               "ica:toNode": "node:System" },
    { "@id": "edge:ServiceDown-runbook-covers-PaymentSvc",  "@type": "ica:Edge", "ica:label": "COVERS_SYSTEM",  "ica:from": "SERVICE_DOWN_RUNBOOK",    "ica:fromNode": "node:KnowledgeArticle", "ica:to": "Payment Service",           "ica:toNode": "node:System" },

    {
      "@comment": "================================================================",
      "@comment": "SECTION 3 — CONSTRAINTS (Business Rules as enforceable instances)",
      "@comment": "================================================================"
    },

    { "@id": "constraint:BR-001", "@type": "ica:Constraint", "ica:constraintId": "BR-001", "ica:name": "incident_id format",                    "ica:appliesTo": "node:Incident",         "ica:field": "incident_id",       "ica:ruleType": "PatternMatch",       "ica:expression": "incident_id matches /^INC-[0-9]{4,}$/",                                              "ica:severity": "error",   "ica:message": "Incident ID must follow format INC-XXXX (e.g. INC-2847)"                               },
    { "@id": "constraint:BR-002", "@type": "ica:Constraint", "ica:constraintId": "BR-002", "ica:name": "severity enumerated",                   "ica:appliesTo": "node:Incident",         "ica:field": "severity",          "ica:ruleType": "AllowedValues",      "ica:allowedValues": ["P1","P2","P3","P4"],                                                              "ica:severity": "error",   "ica:message": "Severity must be P1, P2, P3 or P4"                                                     },
    { "@id": "constraint:BR-003", "@type": "ica:Constraint", "ica:constraintId": "BR-003", "ica:name": "P1 must have affected_services",         "ica:appliesTo": "node:Incident",         "ica:field": "affected_services", "ica:ruleType": "ConditionalRequired", "ica:condition": "severity == 'P1'", "ica:expression": "affected_services.length >= 1",                                                      "ica:severity": "error",   "ica:message": "P1 incidents must name at least one affected service"                                   },
    { "@id": "constraint:BR-004", "@type": "ica:Constraint", "ica:constraintId": "BR-004", "ica:name": "P2 auto-promotes to P1 at T+120min",    "ica:appliesTo": "node:Incident",         "ica:field": "severity",          "ica:ruleType": "TemporalPromotion",  "ica:condition": "severity == 'P2' AND status IN ['open','in-progress']", "ica:expression": "(now - created_at) >= 120 → set severity = 'P1'",                                    "ica:severity": "error",   "ica:message": "P2 unresolved after 120 min — promote to P1 and trigger P1-path"                       },
    { "@id": "constraint:BR-005", "@type": "ica:Constraint", "ica:constraintId": "BR-005", "ica:name": "Resolution required to close incident", "ica:appliesTo": "node:Incident",         "ica:field": "status",            "ica:ruleType": "RelationshipRequired","ica:condition": "status == 'resolved'", "ica:expression": "RESOLVED_BY edge must exist with matching incident_id",                              "ica:severity": "error",   "ica:message": "Cannot mark incident resolved without a linked Resolution"                              },
    { "@id": "constraint:BR-006", "@type": "ica:Constraint", "ica:constraintId": "BR-006", "ica:name": "Resolution must have steps",            "ica:appliesTo": "node:Resolution",       "ica:field": "resolution_steps",  "ica:ruleType": "MinItems",           "ica:expression": "resolution_steps.length >= 1",                                                       "ica:severity": "error",   "ica:message": "Resolution must include at least one resolution step"                                   },
    { "@id": "constraint:BR-007", "@type": "ica:Constraint", "ica:constraintId": "BR-007", "ica:name": "Runbook must link to an alert",         "ica:appliesTo": "node:KnowledgeArticle", "ica:field": "relatedAlerts",     "ica:ruleType": "RelationshipRequired","ica:condition": "article_type == 'runbook'", "ica:expression": "TRIAGES edge must exist to at least one alert KnowledgeArticle",                    "ica:severity": "error",   "ica:message": "Runbook without a linked alert cannot be retrieved by alert-triggered queries"          },
    { "@id": "constraint:BR-008", "@type": "ica:Constraint", "ica:constraintId": "BR-008", "ica:name": "Runbook must reference escalation path","ica:appliesTo": "node:KnowledgeArticle", "ica:field": "governedBy",        "ica:ruleType": "RelationshipRequired","ica:condition": "article_type == 'runbook'", "ica:expression": "GOVERNED_BY edge must exist to an EscalationPath node",                             "ica:severity": "error",   "ica:message": "Every runbook must define when to escalate via a GOVERNED_BY edge"                      },
    { "@id": "constraint:BR-009", "@type": "ica:Constraint", "ica:constraintId": "BR-009", "ica:name": "Runbook staleness warning at 180 days", "ica:appliesTo": "node:KnowledgeArticle", "ica:field": "updated_at",        "ica:ruleType": "Staleness",          "ica:condition": "article_type == 'runbook'", "ica:warningThresholdDays": 180, "ica:blockThresholdDays": 365,                                          "ica:severity": "warning", "ica:message": "Runbook not reviewed in 180+ days — Bob will append staleness warning to citations"     },
    { "@id": "constraint:BR-010", "@type": "ica:Constraint", "ica:constraintId": "BR-010", "ica:name": "content minimum 200 characters",        "ica:appliesTo": "node:KnowledgeArticle", "ica:field": "content",           "ica:ruleType": "MinLength",          "ica:expression": "content.length >= 200",                                                              "ica:severity": "error",   "ica:message": "Documents shorter than 200 characters produce no useful RAG chunks"                     },
    { "@id": "constraint:BR-011", "@type": "ica:Constraint", "ica:constraintId": "BR-011", "ica:name": "Alert fatigue review policy",           "ica:appliesTo": "node:KnowledgeArticle", "ica:field": "tags",              "ica:ruleType": "OperationalPolicy",  "ica:condition": "article_type == 'alert'", "ica:expression": "firingCount > 10 per week with no action → observability-review Jira ticket required","ica:severity": "warning", "ica:message": "Alert firing too frequently — open observability-review ticket within 2 weeks"           },
    { "@id": "constraint:BR-012", "@type": "ica:Constraint", "ica:constraintId": "BR-012", "ica:name": "Resolution.incident_id must exist",    "ica:appliesTo": "node:Resolution",       "ica:field": "incident_id",       "ica:ruleType": "ReferentialIntegrity","ica:expression": "Resolution.incident_id must match an existing Incident.incident_id",                  "ica:severity": "error",   "ica:message": "Resolution references a non-existent incident — upload the incident document first"     },
    { "@id": "constraint:BR-013", "@type": "ica:Constraint", "ica:constraintId": "BR-013", "ica:name": "P1/P2 must reference production systems","ica:appliesTo": "node:Incident",        "ica:field": "affected_services", "ica:ruleType": "ConditionalConstraint","ica:condition": "severity IN ['P1','P2']", "ica:expression": "all AFFECTS edges must point to System nodes with environment == 'production'",       "ica:severity": "warning", "ica:message": "P1/P2 incidents should only reference production systems"                               },
    { "@id": "constraint:BR-014", "@type": "ica:Constraint", "ica:constraintId": "BR-014", "ica:name": "EscalationPath steps must be ordered",  "ica:appliesTo": "node:EscalationPath",   "ica:field": "steps",             "ica:ruleType": "OrderingConstraint", "ica:expression": "steps[i].at_minutes <= steps[i+1].at_minutes for all i",                              "ica:severity": "error",   "ica:message": "Escalation steps must be in non-decreasing chronological order"                        }

  ]
}
