# Copy this file to .env and fill in your values

# ── Primary LLM: Google Gemini ──────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# ── Backup LLM: Groq (used automatically when Gemini hits rate limit) ──
# Free tier at https://console.groq.com — no credit card required
# Leave blank to disable the backup
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── AWS: S3 Document Storage ─────────────────────────────────────
# Leave S3_BUCKET_NAME blank to use local runbooks/incidents/docs folders (default)
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ── AWS: Secrets Manager ─────────────────────────────────────────
# Set to the ARN or name of your secret to pull API keys from Secrets Manager.
# Leave blank to keep using the keys above from this .env file (default).
# Secret must be a JSON object: {"GOOGLE_API_KEY":"...","GROQ_API_KEY":"..."}
SECRETS_MANAGER_ARN=
